terraform {
  required_version = ">= 1.0.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# [DEVSECOPS] Membuat VPC yang aman untuk aplikasi
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name        = "devsecops-vpc"
    Environment = "Portfolio"
    ManagedBy   = "Terraform"
  }
}

# Membuat Public Subnet
resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true

  tags = {
    Name = "devsecops-public-subnet"
  }
}

# [DEVSECOPS BEST PRACTICE] Security Group dengan aturan ketat (Least Privilege)
resource "aws_security_group" "app_sg" {
  name        = "app-security-group"
  description = "Allow inbound traffic only on ports 80, 443, and 3000"
  vpc_id      = aws_vpc.main.id

  # Izinkan akses HTTP biasa
  ingress {
    description = "HTTP from anywhere"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Izinkan akses port aplikasi Node.js (untuk portofolio/demo)
  ingress {
    description = "App Port"
    from_port   = 3000
    to_port     = 3000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Keluar bebas (Egress)
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "devsecops-sg"
  }
}
